<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tutorial Player</title>
    <link href="style.css" rel="stylesheet">
    <link href="title-image.png" type="image/png" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200..1000&family=Monoton&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">

</head>
<body>
    <div class="main">
        <div class="navbar">
            <p class="nav-card first">Start date: <span class="ar">N/A</span></p>
            <p class="nav-card todayDate">Today: <span class="ar">جوزا 21</span></p>
            <p class="nav-card fourth">Finish date: <span class="ar">سرطان 12</span></p>
            <p class="nav-card logo">SEELOO</p>
            <p class="nav-card second">0% Completed</p>
            <p class="nav-card third">0 lectures each day</p>
            <p class="nav-card covered">Covered Today: 0 </p>
            <div class="speed-display"></div>
            
        </div>

        <div class="video">
            <video class="myvideo" controls> 
                <source src="video.mp4" type="video/mp4">
                <track
        src="video.vtt"
        kind="subtitles"
        srclang="en"
        label="English"
        default
    >
                Your browser does not support the video tag
            </video>
            <iframe class="myframe" src="web.html" style="display: none;"></iframe>
        </div>



        <div class="lessons">
    <% let i = 1 %>
    <% for (const lesson of lessons) { %>

        <div
            class="cards
            <%= lesson.is_video == 1 ? 'is-video' : 'is-file' %>
            <%= lesson.is_seen == 1 ? 'pressed' : '' %>"
            data-id="<%= lesson.lesson_id %>"
            data-isvideo="<%= lesson.is_video %>"
        >
            <h4><%= i %></h4>
        </div>

        <% i++ %>

    <% } %>
</div>





        
    </div>
     <script src="jquery.js"></script>
    <script src="frontend.js" ></script>
</body>
</html>


